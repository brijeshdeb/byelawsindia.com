# ============================================================
# Byelawsindia.com — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# The anon key is safe to expose to the browser — RLS is the guard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key MUST NEVER reach the browser.
# Only used in server-side service modules and scheduled jobs.
# If this key is ever logged or exposed, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application ───────────────────────────────────────────────
# Public URL of this deployment (used in emails, webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application environment: development | staging | production
NODE_ENV=development
APP_ENV=development

# ── Email (Resend) ────────────────────────────────────────────
# Used only by the server-side NotificationService.
# Never pass this to the browser.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@byelawsindia.com
EMAIL_FROM_NAME="Byelawsindia Portal"

# ── Webhook signing ───────────────────────────────────────────
# Secret used to verify Resend webhook payloads.
# Generate with: openssl rand -hex 32
RESEND_WEBHOOK_SECRET=your-webhook-secret

# ── Document storage ─────────────────────────────────────────
# Supabase Storage bucket names (must match what you create in Supabase)
STORAGE_BUCKET_DOCUMENTS=society-documents
STORAGE_BUCKET_AVATARS=avatars
# Signed URL TTL in seconds (default: 60 seconds)
STORAGE_SIGNED_URL_TTL=60

# ── Rate limiting ─────────────────────────────────────────────
# Login attempts per window
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ── Monitoring (Sentry) ───────────────────────────────────────
# Optional. Leave empty to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── File upload limits ────────────────────────────────────────
# Maximum upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
